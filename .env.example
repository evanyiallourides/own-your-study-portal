# ============================================================================
# Own Your Study Portal — environment
# ----------------------------------------------------------------------------
# Copy to .env.local and fill in. Never commit the filled-in file.
#
# With NONE of these set, the portal still runs: it starts in demo mode against
# an in-memory dataset so every screen can be walked through. Demo mode is
# labelled on every page and cannot reach a database, a model or a meeting.
# ============================================================================

# -- Supabase --------------------------------------------------------------
# Project settings → API. The anon key is public by design; every query it
# makes is filtered by Row Level Security.
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# Bypasses Row Level Security entirely. Server-only, never sent to a browser.
# Used by three things and nothing else: the Recall webhook, the analysis
# pipeline, and admin invitations. Treat it like a root password.
SUPABASE_SERVICE_ROLE_KEY=

# -- OpenAI ----------------------------------------------------------------
# Turns a lesson transcript into a structured draft for the tutor to review.
# Without it, transcripts are still captured and stored; tutors simply write
# the lesson up themselves.
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4.1

# -- Recall.ai -------------------------------------------------------------
# The meeting bot that joins Google Meet / Zoom / Teams and produces the
# speaker-labelled transcript.
RECALL_API_KEY=
# One of: us-east-1, us-west-2, eu-central-1, ap-northeast-1
RECALL_REGION=us-west-2
# From the Recall dashboard's webhook settings. The webhook endpoint refuses
# every request when this is unset — it will not accept unsigned deliveries.
RECALL_WEBHOOK_SECRET=

# -- Google Calendar and Meet ----------------------------------------------
# Optional. With these set, a tutor can connect their own Google account and
# the portal will create a real Meet link for each lesson and invite the
# student to it. Without them, meeting links are pasted in by hand and
# everything else works unchanged.
#
# From a Google Cloud project: enable the Google Calendar API, create an OAuth
# 2.0 Client ID of type "Web application", and add this exact redirect URI:
#   <NEXT_PUBLIC_APP_URL>/api/google/callback
# The consent screen needs the .../auth/calendar.events scope. That scope is
# deliberately narrow: it can manage the events the portal creates and cannot
# read the rest of a tutor's diary.
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# -- URLs ------------------------------------------------------------------
# Where this portal is reachable. Used to build magic-link and invitation
# redirect targets, so it must match the deployed origin exactly.
NEXT_PUBLIC_APP_URL=http://localhost:3000
# The public marketing site, linked to from the login page.
NEXT_PUBLIC_MARKETING_URL=https://ownyourstudy.com

# -- Development -----------------------------------------------------------
# Force the in-memory demo dataset even when Supabase credentials are present.
# Useful for design work. Never set this in production.
# NEXT_PUBLIC_PORTAL_DEMO_MODE=false

# -- Stripe ----------------------------------------------------------------
# Payments, including the instalment plans. The account created through Xero
# is a normal Stripe account: dashboard.stripe.com → Developers → API keys.
#
# The key decides which set of prices is charged — test and live have separate
# price IDs — so there is deliberately no STRIPE_MODE variable to get out of
# step with it. Run `npm run stripe:setup` once per mode to create the products
# and prices from the catalogue.
STRIPE_SECRET_KEY=

# From Developers → Webhooks, on the endpoint pointed at
#   <NEXT_PUBLIC_APP_URL>/api/webhooks/stripe
# Different per endpoint AND per mode. Locally, `stripe listen` prints one.
# The webhook refuses every delivery when this is unset — it will not accept
# unsigned events, because an unsigned event can grant paid access.
STRIPE_WEBHOOK_SECRET=

# Optional. Payment method configuration IDs from Settings → Payments. Two are
# needed because Stripe does not allow Klarna / Zip / Afterpay in subscription
# mode: one configuration with them for paying in full, one card-only for
# instalments. Unset, Stripe uses the account default for both.
STRIPE_PMC_FULL=
STRIPE_PMC_INSTALMENTS=
